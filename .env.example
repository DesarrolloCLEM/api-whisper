# API Configuration
API_TITLE=Whisper API
API_VERSION=1.0.0
API_DESCRIPTION=API para conversión de audio a texto y texto a audio usando Whisper

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (SQLite para API keys)
DATABASE_URL=sqlite:///./api_keys.db

# Whisper Configuration (faster-whisper)
# Modelos disponibles: tiny, base, small, medium, large-v1, large-v2, large-v3, large-v3-turbo
# large-v3-turbo es el mejor para español con mejor velocidad/precisión
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
# Compute type: int8 (más rápido en CPU), int8_float16 (balance), float16 (más preciso en GPU)
WHISPER_COMPUTE_TYPE=int8
# Idioma por defecto (es para español, en para inglés, None para auto-detección)
WHISPER_LANGUAGE=es
# Número de workers para procesamiento paralelo
WHISPER_NUM_WORKERS=1
# Token opcional de Hugging Face (para descargas más rápidas y sin warnings)
# Obtén tu token en: https://huggingface.co/settings/tokens
HF_TOKEN=

# TTS Configuration (Text-to-Speech)
# Proveedor de TTS: "google" (gTTS - gratis) o "elevenlabs" (mejor calidad, requiere API key)
TTS_PROVIDER=google
# API Key de ElevenLabs (requerida si TTS_PROVIDER=elevenlabs)
# Obtén tu API key en: https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Voice ID de ElevenLabs (opcional, se selecciona automáticamente según idioma si está vacío)
# Voces recomendadas en español:
#   - nMPrFLO7QElx9wTR0JGo (Ginyin - masculino España)
#   - GPzYRfJNEJniCw2WrKzi (Yinet - femenino Colombia)
#   - 15bJsujCI3tcDWeoZsQP (Santiago - masculino México)
# Puedes ver todas las voces en: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# API Key Configuration
API_KEY_HEADER_NAME=X-API-Key
API_KEY_LENGTH=32

# Carpeta donde se guardan los audios recibidos antes de transcribir (ruta relativa al directorio del proyecto)
AUDIO_UPLOADS_DIR=uploads/audio
